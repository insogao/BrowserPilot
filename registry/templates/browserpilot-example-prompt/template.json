{
  "id": "browserpilot-example-prompt",
  "name": "示例 Prompt 模板",
  "version": "1.1.0",
  "description": "把输入主题整理为一个不执行网页动作的示例提示词。",
  "category": "generic",
  "inputs": [
    {
      "name": "topic",
      "type": "string",
      "required": true,
      "description": "要处理的主题"
    }
  ],
  "steps": "prompt",
  "body": "请围绕以下主题继续处理：$topic",
  "scope": {
    "sites": []
  },
  "discovery": {
    "intents": ["prompt.compose", "registry.verify"],
    "keywords": ["示例", "prompt", "模板", "registry"],
    "outputs": [
      {
        "name": "prompt",
        "type": "string",
        "description": "拼装后的提示词"
      }
    ],
    "risk": "read",
    "aliases": ["example-prompt"],
    "browserpilot": ">=0.1.0"
  }
}
