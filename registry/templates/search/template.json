{
  "id": "search",
  "name": "Google Search",
  "version": "1.1.0",
  "description": "在 Google 搜索关键词，返回指定条数结果（默认 10，最多 100；不足时自动翻页，页间有礼貌间隔）。",
  "category": "search",
  "tags": [
    "search"
  ],
  "inputs": [
    {
      "name": "query",
      "type": "string",
      "required": true,
      "description": "Search query"
    },
    {
      "name": "limit",
      "type": "number",
      "required": false,
      "default": 10,
      "description": "返回结果条数（默认 10，最多 100）"
    },
    {
      "name": "maxPages",
      "type": "number",
      "required": false,
      "default": 5,
      "description": "最多翻页数（默认 5，上限 10；只有结果不足 limit 时才翻页）"
    }
  ],
  "steps": "commands",
  "body": [
    {
      "name": "open_tab",
      "args": {
        "url": "https://www.google.com"
      },
      "note": "Open Google homepage."
    },
    {
      "name": "js",
      "args": {
        "expression": "@focus",
        "selectors": [
          "textarea[name='q']",
          "input[name='q']",
          "input[type='search']",
          "input[type='text']"
        ]
      },
      "expect": "true",
      "note": "Wait for and focus the search input."
    },
    {
      "name": "fill",
      "args": {
        "selector": "[data-bp-focus]",
        "value": "$query"
      },
      "note": "Fill the search query."
    },
    {
      "name": "press",
      "args": {
        "key": "Enter",
        "selector": "[data-bp-focus]"
      },
      "note": "Submit the search."
    },
    {
      "name": "waitForSelector",
      "args": {
        "selector": "#search,#rso,#center_col",
        "visible": true,
        "timeoutMs": 20000
      },
      "note": "Wait for results DOM, independent of regional domain."
    },
    {
      "name": "js",
      "args": {
        "expression": "@results",
        "rootSelectors": [
          "#search",
          "#rso",
          "#center_col"
        ],
        "minResults": 3,
        "limit": "$limit",
        "textLimit": 6000,
        "excludeUrlPrefixes": [
          "/search?",
          "/imgres",
          "/preferences",
          "/advanced_search",
          "/intl/",
          "/settings",
          "/webhp",
          "/maps",
          "/shopping",
          "/translate",
          "/travel",
          "/support",
          "/policies",
          "/accounts",
          "https://www.google.com/search?",
          "https://www.google.com/preferences",
          "https://www.google.com/intl/",
          "https://www.google.com/webhp"
        ],
        "maxPages": "$maxPages",
        "nextSelector": "#pnnext"
      },
      "note": "抓取搜索结果（排除 Google 自家 UI 链接）"
    }
  ],
  "tokenStrategy": {
    "defaultL0": true
  },
  "scope": {
    "sites": [
      "google.com",
      "google.com.hk",
      "google.co.jp",
      "google.co.uk"
    ]
  },
  "discovery": {
    "intents": [
      "search",
      "web.search"
    ],
    "keywords": [
      "google",
      "search",
      "web search"
    ],
    "outputs": [
      {
        "name": "count",
        "type": "number",
        "description": "Number of results returned"
      },
      {
        "name": "links",
        "type": "array",
        "description": "Result list, each with title and url"
      },
      {
        "name": "text",
        "type": "string",
        "description": "Visible text from the result container"
      }
    ],
    "risk": "read",
    "aliases": [
      "google",
      "google-search"
    ],
    "browserpilot": ">=0.1.0"
  }
}
