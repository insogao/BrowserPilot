{
  "manifest_version": 3,
  "name": "Browser CLI Import (source)",
  "version": "0.2.0",
  "description": "User-authorized, local-only cookie transfer from Chrome/Edge to Browser CLI. Reads only selected domains through the official cookies API; never uploads; never logs cookie values.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Browser CLI Import (source)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
