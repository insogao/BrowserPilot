{
  "manifest_version": 3,
  "name": "Browser CLI Cookie Bridge (target)",
  "version": "0.1.0",
  "description": "Receives user-authorized cookies from a local source-browser bridge and writes them into this profile via the official chrome.cookies API.",
  "key": "",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Browser CLI Cookie Bridge (target)",
    "default_popup": "popup.html"
  }
}
