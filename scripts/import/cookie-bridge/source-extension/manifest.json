{
  "manifest_version": 3,
  "name": "Browser CLI Cookie Bridge (source)",
  "version": "0.1.0",
  "description": "User-authorized local cookie transfer to Browser CLI. Reads cookies only through the official chrome.cookies API; never uploads them.",
  "key": "",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Browser CLI Cookie Bridge (source)",
    "default_popup": "popup.html"
  }
}
